# Training modules, simulator source, and existing experiment data roots.
/*
!/environments/
!/ddpg_webots/
!/sac_webots/
!/sac_isaac_lab/
!/expert/
/expert/docs/
!/README.md
!/.gitignore
!/.gitattributes
!/tools/
/tools/*
!/tools/export_run_models.py

# Keep public READMEs in source directories; working notes stay local.
*.md
!README.md
docs/
.agents/
.codex/
.claude/
.chatgpt/
*transcript*.json*
*conversation*.json*
*codex*.json*
*codex*.log
*.transcript
*.jsonl
*.jsonl.gz

# Installed SDKs/environments are prerequisites, not portable project sources.
/sac_isaac_lab/runtime/
**/.webots_runs/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.git/

# Local migration mirrors and tool caches.
**/.portable_check/

/environments/isaac_lab/checks/
/environments/isaac_lab/reports/

# Local experiment output (keep experiment configuration in Git).
/*_webots/**/logs/
/*_webots/**/runs/
/*_webots/**/checks/
/*_webots/**/*.log
/*_webots/**/*.err
/sac_isaac_lab/experiments/**/logs/
/sac_isaac_lab/experiments/**/runs/
/sac_isaac_lab/experiments/**/checks/
/sac_isaac_lab/experiments/**/*.log
/sac_isaac_lab/experiments/**/*.err

/sac_isaac_lab/source_tasks/experiments/*/reports/offline_check.json

# Historical copies and generated analyses outside the normal run directories.
/ddpg_webots/data/baseline/history/
/*_webots/data/baseline/comparison.*
/ddpg_webots/data/**/*.csv
/ddpg_webots/data/**/comparison/
/ddpg_webots/data/**/provenance/
/ddpg_webots/data/**/summary.json
/ddpg_webots/data/**/comparison.json
/ddpg_webots/data/**/execution*.json
/ddpg_webots/data/**/previous_execution.json
/ddpg_webots/data/**/offline_check.json
/ddpg_webots/data/**/*_audit.json
/ddpg_webots/data/**/policy_sensitivity.json
/ddpg_webots/data/**/bc/fit_*/metrics.*
/ddpg_webots/data/**/bc/fit_*/result.json

# Training outputs are local except selected models and final reports.
**/reports/**
**/runs/**
**/multi_gpu_runs/
!/sac_isaac_lab/experiments/*/*/multi_gpu_runs/
**/multi_gpu_runs/**
!**/multi_gpu_runs/config_*/
!**/multi_gpu_runs/train_*/
!**/multi_gpu_runs/config_*/train_*/
!**/multi_gpu_runs/latest_run.txt
!**/multi_gpu_runs/**/train_*/checkpoints/
!**/multi_gpu_runs/**/train_*/checkpoints/.gitignore
# Each selected run names its publishable native checkpoints in a local .gitignore.
!/ddpg_webots/data/**/runs/
!/sac_webots/data/experiments/*/runs/
!/sac_isaac_lab/experiments/*/*/runs/
!**/runs/config_*/
!**/runs/train_*/
!**/runs/config_*/train_*/
!**/runs/latest_run.txt
!**/runs/**/train_*/checkpoints/
!**/runs/**/train_*/checkpoints/.gitignore
# The default Isaac experiment loads this warm-start model at its original path.
!/sac_isaac_lab/experiments/training_trials/walk_lateral/runs/train_20261122T100335Z_b14a36/checkpoints/
!/sac_isaac_lab/experiments/training_trials/walk_lateral/runs/train_20261122T100335Z_b14a36/checkpoints/step_00050000.pth
!/sac_isaac_lab/experiments/training_trials/walk_lateral_random_vx/runs/
!/sac_isaac_lab/experiments/training_trials/walk_lateral_random_vx/runs/train_20261122T233600Z_003e41/
!/sac_isaac_lab/experiments/training_trials/walk_lateral_random_vx/runs/train_20261122T233600Z_003e41/report/
!/sac_isaac_lab/experiments/training_trials/walk_lateral_random_vx/runs/train_20261122T233600Z_003e41/report/index.html
!/ddpg_webots/data/cycle_mean_gaussian/reports/001_20261119T051822_377132Z/
!/ddpg_webots/data/cycle_mean_gaussian/reports/001_20261119T051822_377132Z/index.html
!/ddpg_webots/data/step_narrow_gaussian/reports/003_20261119T075654_518240Z/
!/ddpg_webots/data/step_narrow_gaussian/reports/003_20261119T075654_518240Z/index.html
!/ddpg_webots/data/step_wide_gaussian/variants/turn_and_walk/forward_lateral/resume_30k_to_60k/reports/002_20261121T060847_123339Z/
!/ddpg_webots/data/step_wide_gaussian/variants/turn_and_walk/forward_lateral/resume_30k_to_60k/reports/002_20261121T060847_123339Z/index.html
!/ddpg_webots/data/walk_only/variants/legacy_linear_bc50_v070/reports/walk_only_20261122T064541_065992Z/
